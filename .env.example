# ============================================================
# Lo Más Cute — variables de entorno
#
# Copia este archivo como `.env.local` y rellena los valores.
# `.env.local` ya está en .gitignore: nunca se sube al repositorio.
# ============================================================

# --- Supabase ------------------------------------------------
# Panel del proyecto → Project Settings → API

# URL del proyecto. Es pública.
NEXT_PUBLIC_SUPABASE_URL=https://TU_REFERENCIA.supabase.co

# Clave pública. Lo es por diseño: RLS es lo que protege los datos, no el
# secreto de esta clave. Formato nuevo `sb_publishable_…` o JWT con role anon.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role. SE SALTA RLS.
#
# Nunca la pongas con el prefijo NEXT_PUBLIC_ ni la uses en un componente de
# cliente: acabaría en el bundle del navegador y cualquiera podría borrar el
# catálogo. Solo la lee `src/lib/supabase/client.ts`, que está marcado como
# `server-only`.
#
# Mientras no exista autenticación, esta clave es lo único que permite
# escribir desde el panel. Al añadir login, se sustituye por políticas RLS
# contra usuarios autenticados (ver supabase/migrations/0002_rls.sql).
#
# Tiene que ser la PRIVADA: formato nuevo `sb_secret_…` o JWT con
# role service_role. Poner aquí la pública por error no da ningún fallo al
# arrancar —el catálogo se lee igual porque es público— y el panel solo revienta
# al abrir /admin/pedidos con «permission denied for table orders».
#
# Va también en el entorno de producción (Vercel → Settings → Environment
# Variables). Si rotas las claves en Supabase, hay que actualizarla en los dos
# sitios: `npm run supabase:check` lo verifica.
SUPABASE_SERVICE_ROLE_KEY=

# --- Correo (Resend) ----------------------------------------
# Avisos a la tienda cuando entra un pedido. Sin estas variables la tienda
# funciona igual: el pedido se guarda y aparece en /admin/pedidos, pero nadie
# recibe el correo. El panel lo advierte en la lista de pedidos.

# Clave de API de https://resend.com → API Keys. Empieza por `re_`.
# Solo la lee `src/lib/email.ts`, que está marcado como `server-only`: nunca
# le pongas el prefijo NEXT_PUBLIC_ ni la uses en un componente de cliente.
RESEND_API_KEY=

# Remitente de los correos.
#
# Sin valor se usa `onboarding@resend.dev`, el remitente de pruebas de Resend:
# funciona sin verificar ningún dominio, pero SOLO entrega al correo con el que
# se registró la cuenta. Suficiente para que te lleguen tus propios avisos.
#
# Para escribirle a cualquier otra dirección —por ejemplo, confirmaciones al
# cliente— hay que verificar el dominio en Resend (unos registros DNS) y poner
# aquí algo como `pedidos@tudominio.com`.
EMAIL_FROM=

# A dónde llegan los avisos de pedido.
#
# Vacío es lo normal: se usa el correo de la tienda que esté guardado en
# /admin/configuracion, así que se cambia desde el panel sin desplegar. Esta
# variable solo hace falta si los avisos internos deben ir a una dirección
# distinta de la que se publica en la web.
ORDER_NOTIFICATION_EMAIL=
